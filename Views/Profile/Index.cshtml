@model E_Commerce.Models.User

@{
    Layout = null;
    var orderCount = (int)(ViewBag.OrderCount ?? 0);
    var wishlistCount = (int)(ViewBag.WishlistCount ?? 0);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Profile</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: 
                radial-gradient(ellipse at top right, rgba(92, 124, 250, 0.08), transparent 50%),
                linear-gradient(135deg, #f8faff 0%, #eef2ff 50%, #f5f8ff 100%);
            min-height: 100vh;
            padding: 40px 20px;
            color: #111827;
            -webkit-font-smoothing: antialiased;
        }

        @@keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        .container { max-width: 800px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; animation: fadeInUp 400ms ease-out; }
        .header h1 { font-size: 1.8rem; font-weight: 900; letter-spacing: -0.03em; }
        .back { display: inline-flex; align-items: center; gap: 6px; font-size: 0.88rem; font-weight: 700; color: #3b5bdb; text-decoration: none; background: #eff6ff; padding: 10px 18px; border-radius: 12px; border: 1.5px solid #bfdbfe; transition: all 200ms ease; }
        .back:hover { background: #dbeafe; transform: translateY(-1px); }

        .toast { position: fixed; top: 24px; right: 24px; z-index: 9999; padding: 14px 22px; border-radius: 14px; color: #fff; background: linear-gradient(135deg, #059669, #10b981); box-shadow: 0 12px 30px rgba(5, 150, 105, 0.3); font-size: 0.92rem; font-weight: 700; opacity: 0; transform: translateY(-16px) scale(0.95); transition: all 300ms cubic-bezier(0.34, 1.56, 0.64, 1); }
        .toast.show { opacity: 1; transform: translateY(0) scale(1); }

        .profile-card {
            background: #ffffff;
            border-radius: 24px;
            border: 1.5px solid #e2e8f0;
            padding: 36px;
            margin-bottom: 24px;
            box-shadow: 0 4px 24px rgba(17, 24, 39, 0.05);
            animation: fadeInUp 500ms ease-out 100ms both;
        }

        .profile-header { display: flex; align-items: center; gap: 20px; margin-bottom: 28px; }
        .avatar {
            width: 68px;
            height: 68px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b5bdb, #5c7cfa);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            font-weight: 800;
            box-shadow: 0 8px 20px rgba(59, 91, 219, 0.25);
        }
        .profile-name { font-size: 1.4rem; font-weight: 900; letter-spacing: -0.02em; }
        .profile-email { font-size: 0.9rem; color: #64748b; font-weight: 500; margin-top: 4px; }

        .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-bottom: 28px; }
        .stat {
            background: linear-gradient(135deg, #f8faff, #eef2ff);
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            border: 1.5px solid #e2e8f0;
        }
        .stat-value { font-size: 1.8rem; font-weight: 900; letter-spacing: -0.02em; background: linear-gradient(135deg, #3b5bdb, #5c7cfa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .stat-label { font-size: 0.78rem; color: #64748b; margin-top: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }

        .info-row { display: flex; justify-content: space-between; padding: 14px 0; border-bottom: 1px solid #f1f5f9; }
        .info-row:last-child { border-bottom: none; }
        .info-label { color: #64748b; font-size: 0.9rem; font-weight: 500; }
        .info-value { font-weight: 700; font-size: 0.9rem; color: #111827; }

        .actions { display: flex; gap: 14px; margin-top: 28px; }
        .btn-edit {
            flex: 1;
            padding: 14px;
            text-align: center;
            background: linear-gradient(135deg, #3b5bdb, #5c7cfa);
            color: #fff;
            border-radius: 12px;
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 700;
            transition: all 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 8px 20px rgba(59, 91, 219, 0.25);
        }
        .btn-edit:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(59, 91, 219, 0.35); }

        .btn-password {
            flex: 1;
            padding: 14px;
            text-align: center;
            background: #ffffff;
            color: #111827;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 700;
            transition: all 200ms ease;
        }
        .btn-password:hover { background: #f8faff; border-color: #3b5bdb; color: #3b5bdb; }

        .quick-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; animation: fadeInUp 500ms ease-out 200ms both; }
        .quick-link {
            padding: 20px;
            background: #ffffff;
            border: 1.5px solid #e2e8f0;
            border-radius: 16px;
            text-decoration: none;
            color: #111827;
            text-align: center;
            transition: all 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 2px 8px rgba(17, 24, 39, 0.04);
        }
        .quick-link:hover { box-shadow: 0 8px 24px rgba(59, 91, 219, 0.1); transform: translateY(-3px); border-color: rgba(59, 91, 219, 0.2); }
        .quick-link-icon { font-size: 28px; margin-bottom: 8px; }
        .quick-link-text { font-size: 0.85rem; font-weight: 700; color: #475569; }

        @@media (max-width: 640px) {
            .actions { flex-direction: column; }
            .quick-links { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    @if (TempData["Success"] != null)
    {
        <div id="toast" class="toast">@TempData["Success"]</div>
    }

    <div class="container">
        <div class="header">
            <h1>My Profile</h1>
            <a href="/Product/Index" class="back">← Back to Products</a>
        </div>

        <div class="profile-card">
            <div class="profile-header">
                <div class="avatar">@Model.Name[0]</div>
                <div>
                    <div class="profile-name">@Model.Name</div>
                    <div class="profile-email">@Model.Email</div>
                </div>
            </div>

            <div class="stats">
                <div class="stat">
                    <div class="stat-value">@orderCount</div>
                    <div class="stat-label">Orders</div>
                </div>
                <div class="stat">
                    <div class="stat-value">@wishlistCount</div>
                    <div class="stat-label">Wishlist</div>
                </div>
            </div>

            <div class="info-row">
                <span class="info-label">Email</span>
                <span class="info-value">@Model.Email</span>
            </div>
            <div class="info-row">
                <span class="info-label">Address</span>
                <span class="info-value">@Model.Address</span>
            </div>
            <div class="info-row">
                <span class="info-label">Role</span>
                <span class="info-value">@Model.Role</span>
            </div>

            <div class="actions">
                <a href="/Profile/Edit" class="btn-edit">Edit Profile</a>
                <a href="/Profile/ChangePassword" class="btn-password">Change Password</a>
            </div>
        </div>

        <div class="quick-links">
            <a href="/Order/Index" class="quick-link">
                <div class="quick-link-icon">📦</div>
                <div class="quick-link-text">My Orders</div>
            </a>
            <a href="/Product/Wishlist" class="quick-link">
                <div class="quick-link-icon">❤️</div>
                <div class="quick-link-text">Wishlist</div>
            </a>
            <a href="/Product/Cart" class="quick-link">
                <div class="quick-link-icon">🛒</div>
                <div class="quick-link-text">Cart</div>
            </a>
        </div>
    </div>

    <script>
        const toast = document.getElementById("toast");
        if (toast) { requestAnimationFrame(() => toast.classList.add("show")); setTimeout(() => toast.classList.remove("show"), 3000); }
    </script>
</body>
</html>
