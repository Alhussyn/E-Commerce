@model E_Commerce.Models.Order

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order #@Model.Id</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: 
                radial-gradient(ellipse at top right, rgba(92, 124, 250, 0.08), transparent 50%),
                linear-gradient(135deg, #f8faff 0%, #eef2ff 50%, #f5f8ff 100%);
            min-height: 100vh;
            padding: 40px 20px;
            color: #111827;
            -webkit-font-smoothing: antialiased;
        }

        @@keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        .container { max-width: 1000px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; animation: fadeInUp 400ms ease-out; }
        .header h1 { font-size: 1.8rem; font-weight: 900; letter-spacing: -0.03em; }
        .back { display: inline-flex; align-items: center; gap: 6px; font-size: 0.88rem; font-weight: 700; color: #3b5bdb; text-decoration: none; background: #eff6ff; padding: 10px 18px; border-radius: 12px; border: 1.5px solid #bfdbfe; transition: all 200ms ease; }
        .back:hover { background: #dbeafe; transform: translateY(-1px); }

        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px; animation: fadeInUp 500ms ease-out 100ms both; }

        .card { background: #ffffff; border-radius: 20px; border: 1.5px solid #e2e8f0; padding: 28px; box-shadow: 0 4px 24px rgba(17, 24, 39, 0.05); }
        .card-title { font-size: 0.78rem; font-weight: 700; color: #3b5bdb; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 18px; }

        .info-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #f1f5f9; }
        .info-row:last-child { border-bottom: none; }
        .info-label { font-size: 0.9rem; color: #64748b; font-weight: 500; }
        .info-value { font-size: 0.9rem; font-weight: 700; color: #111827; }

        .status-badge { display: inline-block; padding: 5px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
        .status-pending { background: #fef3c7; color: #92400e; border: 1px solid rgba(252, 211, 77, 0.5); }
        .status-processing { background: #dbeafe; color: #1e40af; border: 1px solid rgba(147, 197, 253, 0.5); }
        .status-shipped { background: #d1fae5; color: #065f46; border: 1px solid rgba(110, 231, 183, 0.5); }
        .status-delivered { background: #dcfce7; color: #166534; border: 1px solid rgba(134, 239, 172, 0.5); }
        .status-cancelled { background: #fee2e2; color: #991b1b; border: 1px solid rgba(252, 165, 165, 0.5); }

        .items-card { background: #ffffff; border-radius: 20px; border: 1.5px solid #e2e8f0; padding: 28px; box-shadow: 0 4px 24px rgba(17, 24, 39, 0.05); animation: fadeInUp 500ms ease-out 200ms both; }
        .items-title { font-size: 0.78rem; font-weight: 700; color: #3b5bdb; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 18px; }

        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 12px; font-size: 0.75rem; font-weight: 700; color: #3b5bdb; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 2px solid #e2e8f0; }
        td { padding: 14px 12px; font-size: 0.92rem; border-bottom: 1px solid #f1f5f9; color: #111827; }
        tr:hover td { background: #f8faff; }
        .total-row td { border-bottom: none; font-weight: 800; font-size: 1.05rem; color: #3b5bdb; }

        @@media (max-width: 768px) {
            .grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Order #@Model.Id</h1>
            <a href="/Order/Index" class="back">← Back to Orders</a>
        </div>

        @{
            var statusClass = Model.Status?.ToLower() switch
            {
                "pending" => "status-pending",
                "processing" => "status-processing",
                "shipped" => "status-shipped",
                "delivered" => "status-delivered",
                "cancelled" => "status-cancelled",
                _ => "status-pending"
            };
        }

        <div class="grid">
            <div class="card">
                <div class="card-title">Order Information</div>
                <div class="info-row">
                    <span class="info-label">Order ID</span>
                    <span class="info-value">#@Model.Id</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Date</span>
                    <span class="info-value">@Model.dateTime.ToString("MMM dd, yyyy HH:mm")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Status</span>
                    <span class="status-badge @statusClass">@Model.Status</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Total</span>
                    <span class="info-value">@Model.TotalPrice.ToString("N0") EGP</span>
                </div>
            </div>

            <div class="card">
                <div class="card-title">Shipping Information</div>
                <div class="info-row">
                    <span class="info-label">Name</span>
                    <span class="info-value">@(Model.FullName ?? "-")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Phone</span>
                    <span class="info-value">@(Model.Phone ?? "-")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Address</span>
                    <span class="info-value">@(Model.Address ?? "-")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">City</span>
                    <span class="info-value">@(Model.City ?? "-")</span>
                </div>
                @if (Model.DeliveryDate.HasValue)
                {
                    <div class="info-row">
                        <span class="info-label">Delivery Date</span>
                        <span class="info-value">@Model.DeliveryDate.Value.ToString("MMM dd, yyyy")</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="info-row">
                        <span class="info-label">Notes</span>
                        <span class="info-value">@Model.Notes</span>
                    </div>
                }
            </div>
        </div>

        <div class="items-card">
            <div class="items-title">Order Items</div>
            <table>
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@item.Price.ToString("N0") EGP</td>
                            <td>@item.Quantity</td>
                            <td>@((item.Price * item.Quantity).ToString("N0")) EGP</td>
                        </tr>
                    }
                    <tr class="total-row">
                        <td colspan="3" style="text-align:right;">Total</td>
                        <td>@Model.TotalPrice.ToString("N0") EGP</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
