@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Forgot Password</title>
    <link rel="stylesheet" href="~/css/auth.css">
    <style>
        .single-form-wrap {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        }
        .single-card {
            background: #fff;
            border-radius: 20px;
            padding: 48px 40px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        .single-card .form-header { text-align: center; margin-bottom: 28px; }
        .single-card .form-icon {
            font-size: 32px; color: #4361ee;
            margin-bottom: 12px; display: block;
        }
        .single-card h2 { color: #1a1a2e; font-size: 24px; margin: 0 0 6px; }
        .single-card p  { color: #888; font-size: 14px; margin: 0; }
        .single-card .input-group {
            position: relative; margin-bottom: 16px;
        }
        .single-card .input-group input {
            width: 100%; padding: 13px 16px 13px 42px;
            border: 1.5px solid #e0e0e0; border-radius: 10px;
            font-size: 14px; box-sizing: border-box;
            transition: border-color .2s;
        }
        .single-card .input-group input:focus {
            outline: none; border-color: #4361ee;
        }
        .single-card .input-icon {
            position: absolute; left: 14px; top: 50%;
            transform: translateY(-50%); color: #888;
        }
        .single-card button {
            width: 100%; padding: 13px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            color: #fff; border: none; border-radius: 10px;
            font-size: 15px; font-weight: 600; cursor: pointer;
            margin-top: 4px; transition: opacity .2s;
        }
        .single-card button:hover { opacity: .88; }
        .error-msg   { color: #e63946; font-size: 13px; margin-top: 10px; text-align:center; }
        .success-msg { color: #2dc653; font-size: 13px; margin-top: 10px; text-align:center; }
        .back-link   { display:block; text-align:center; margin-top:18px;
                        font-size:13px; color:#4361ee; text-decoration:none; }
        .back-link:hover { text-decoration:underline; }
    </style>
</head>
<body>

<div class="single-form-wrap">
    <div class="single-card">

        <div class="form-header">
            <span class="form-icon">🔑</span>
            <h2>Forgot Password</h2>
            <p>Enter your email and we'll send you an OTP</p>
        </div>

        <form asp-controller="Auth" asp-action="ForgotPassword" method="post">

            <div class="input-group">
                <span class="input-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <rect x="2" y="4" width="20" height="16" rx="2"/>
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                    </svg>
                </span>
                <input type="email" name="email" placeholder="Email Address" required />
            </div>

            <button type="submit">Send OTP</button>

            @if (ViewBag.Error != null)
            {
                <p class="error-msg">⚠ @ViewBag.Error</p>
            }
            @if (ViewBag.Success != null)
            {
                <p class="success-msg">✔ @ViewBag.Success</p>
            }

        </form>

        <a class="back-link" asp-controller="Auth" asp-action="SignIn">← Back to Sign In</a>

    </div>
</div>

</body>
</html>
