@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Auth</title>
    <link rel="stylesheet" href="~/css/auth.css">
</head>

<body>

    <div class="container" id="container">

        <!-- ================= SIGN UP ================= -->
        <div class="form-container sign-up">
            <form asp-controller="Auth" asp-action="SignUp" method="post">

                <div class="form-header">
                    <div class="form-icon">✦</div>
                    <h2>Create Account</h2>
                    <p>Join us and start shopping today</p>
                </div>

                <div class="input-group">
                    <span class="input-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    </span>
                    <input type="text" name="Name" placeholder="Full Name" required />
                </div>

                <div class="input-group">
                    <span class="input-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
                    </span>
                    <input type="email" name="Email" placeholder="Email Address" required />
                </div>

                <div class="input-group">
                    <span class="input-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                    </span>
                    <input type="password" name="Password" placeholder="Password" required />
                </div>

                <div class="input-group">
                    <span class="input-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                    </span>
                    <input type="text" name="Address" placeholder="Address" required />
                </div>

                <button type="submit">Create Account</button>

                @if (ViewBag.mode == "signup" && ViewBag.error != null)
                {
                    <p class="error-msg">⚠ @ViewBag.error</p>
                }

            </form>
        </div>


        <!-- ================= SIGN IN ================= -->
        <div class="form-container sign-in">
            <form asp-controller="Auth" asp-action="SignIn" method="post">

                <div class="form-header">
                    <div class="form-icon">◈</div>
                    <h2>Welcome Back</h2>
                    <p>Sign in to your account</p>
                </div>

                <div class="input-group">
                    <span class="input-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
                    </span>
                    <input type="email" name="email" placeholder="Email Address" required />
                </div>

                <div class="input-group">
                    <span class="input-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                    </span>
                    <input type="password" name="password" placeholder="Password" required />
                </div>

                <div style="text-align:right; margin-top:-4px; margin-bottom:8px;">
                    <a asp-controller="Auth" asp-action="ForgotPassword"
                       style="font-size:13px; color:#4361ee; text-decoration:none;">
                        Forgot Password?
                    </a>
                </div>

                <button type="submit">Sign In</button>

                @if (ViewBag.mode == "signin" && ViewBag.error != null)
                {
                    <p class="error-msg">⚠ @ViewBag.error</p>
                }
                @if (ViewBag.mode == "signin" && ViewBag.Success != null)
                {
                    <p class="success-msg">✔ @ViewBag.Success</p>
                }

            </form>
        </div>


        <!-- ================= OVERLAY ================= -->
        <div class="overlay-container">
            <div class="overlay">

                <div class="overlay-panel left">
                    <div class="overlay-deco">◈</div>
                    <h2>Welcome Back!</h2>
                    <p>Already have an account? Sign in and continue your journey.</p>
                    <button type="button" onclick="toggle()">Sign In</button>
                </div>

                <div class="overlay-panel right">
                    <div class="overlay-deco">✦</div>
                    <h2>Hello, Friend!</h2>
                    <p>Don't have an account yet? Join us and start exploring.</p>
                    <button type="button" onclick="toggle()">Sign Up</button>
                </div>

            </div>
        </div>

    </div>

    <script>
        function toggle() {
            document.getElementById("container").classList.toggle("active");
        }

        window.onload = function () {
            var mode = "@ViewBag.mode";
            if (mode === "signup") {
                document.getElementById("container").classList.add("active");
            }
        }
    </script>

</body>
</html>
