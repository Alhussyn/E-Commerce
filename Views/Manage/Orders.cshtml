@model List<E_Commerce.Models.Order>

@{
    Layout = null;
    var currentStatus = ViewBag.CurrentStatus as string ?? "all";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manage Orders</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: 
                radial-gradient(ellipse at top right, rgba(92, 124, 250, 0.08), transparent 50%),
                linear-gradient(135deg, #f8faff 0%, #eef2ff 50%, #f5f8ff 100%);
            min-height: 100vh;
            padding: 40px 20px;
            color: #111827;
            -webkit-font-smoothing: antialiased;
        }

        @@keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        .container { max-width: 1100px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; animation: fadeInUp 400ms ease-out; }
        .header h1 { font-size: 1.8rem; font-weight: 900; letter-spacing: -0.03em; }
        .nav-links { display: flex; gap: 10px; }
        .nav-link { display: inline-flex; align-items: center; gap: 6px; font-size: 0.88rem; font-weight: 700; color: #3b5bdb; text-decoration: none; background: #eff6ff; padding: 10px 18px; border-radius: 12px; border: 1.5px solid #bfdbfe; transition: all 200ms ease; }
        .nav-link:hover { background: #dbeafe; transform: translateY(-1px); }

        .filters { display: flex; gap: 10px; margin-bottom: 28px; flex-wrap: wrap; align-items: center; animation: fadeInUp 500ms ease-out 100ms both; }
        .filter-btn { padding: 9px 18px; border-radius: 10px; border: 1.5px solid #e2e8f0; background: #ffffff; font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: all 200ms ease; text-decoration: none; color: #64748b; }
        .filter-btn:hover { border-color: #3b5bdb; color: #3b5bdb; background: #f0f4ff; }
        .filter-btn.active { background: linear-gradient(135deg, #3b5bdb, #5c7cfa); color: #fff; border-color: transparent; box-shadow: 0 4px 12px rgba(59, 91, 219, 0.25); }

        .search-input { padding: 10px 16px; border: 1.5px solid #e2e8f0; border-radius: 12px; font-size: 0.9rem; outline: none; min-width: 260px; transition: all 200ms ease; }
        .search-input:focus { border-color: rgba(59, 91, 219, 0.6); box-shadow: 0 0 0 4px rgba(92, 124, 250, 0.12); }

        .order-card {
            background: #ffffff;
            border-radius: 16px;
            border: 1.5px solid #e2e8f0;
            padding: 22px;
            margin-bottom: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
            animation: fadeInUp 500ms ease-out both;
        }
        .order-card:hover { box-shadow: 0 8px 24px rgba(59, 91, 219, 0.08); transform: translateY(-2px); }

        .order-info { display: flex; gap: 24px; align-items: center; }
        .order-id { font-weight: 800; font-size: 0.95rem; min-width: 80px; color: #111827; }
        .order-meta { font-size: 0.85rem; color: #64748b; font-weight: 500; }
        .order-meta strong { color: #111827; font-weight: 700; }

        .status-badge { display: inline-block; padding: 5px 14px; border-radius: 20px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
        .status-pending { background: #fef3c7; color: #92400e; border: 1px solid rgba(252, 211, 77, 0.5); }
        .status-processing { background: #dbeafe; color: #1e40af; border: 1px solid rgba(147, 197, 253, 0.5); }
        .status-shipped { background: #d1fae5; color: #065f46; border: 1px solid rgba(110, 231, 183, 0.5); }
        .status-delivered { background: #dcfce7; color: #166534; border: 1px solid rgba(134, 239, 172, 0.5); }
        .status-cancelled { background: #fee2e2; color: #991b1b; border: 1px solid rgba(252, 165, 165, 0.5); }

        .btn-view {
            padding: 9px 18px;
            background: linear-gradient(135deg, #3b5bdb, #5c7cfa);
            color: #fff;
            border-radius: 10px;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 700;
            transition: all 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 4px 12px rgba(59, 91, 219, 0.2);
        }
        .btn-view:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(59, 91, 219, 0.3); }

        .empty { text-align: center; padding: 80px 24px; color: #64748b; animation: fadeInUp 500ms ease-out; }
        .empty p { font-size: 1.1rem; font-weight: 600; color: #475569; }

        @@media (max-width: 768px) {
            .order-card { flex-direction: column; align-items: flex-start; gap: 16px; }
            .order-info { flex-wrap: wrap; gap: 16px; }
            .search-input { min-width: 100%; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Manage Orders</h1>
            <div class="nav-links">
                <a href="/Manage/Index" class="nav-link">← Dashboard</a>
            </div>
        </div>

        <form method="get" class="filters">
            <a href="/Manage/Orders?status=all" class="filter-btn @(currentStatus == "all" ? "active" : "")">All</a>
            <a href="/Manage/Orders?status=Pending" class="filter-btn @(currentStatus == "Pending" ? "active" : "")">Pending</a>
            <a href="/Manage/Orders?status=Processing" class="filter-btn @(currentStatus == "Processing" ? "active" : "")">Processing</a>
            <a href="/Manage/Orders?status=Shipped" class="filter-btn @(currentStatus == "Shipped" ? "active" : "")">Shipped</a>
            <a href="/Manage/Orders?status=Delivered" class="filter-btn @(currentStatus == "Delivered" ? "active" : "")">Delivered</a>
            <a href="/Manage/Orders?status=Cancelled" class="filter-btn @(currentStatus == "Cancelled" ? "active" : "")">Cancelled</a>
            <input type="text" name="searchTerm" class="search-input" placeholder="Search by name, phone, city, or order ID..." value="@searchTerm" />
            <input type="hidden" name="status" value="@currentStatus" />
            <button type="submit" class="filter-btn">Search</button>
        </form>

        @if (!Model.Any())
        {
            <div class="empty">
                <p>No orders found.</p>
            </div>
        }

        @foreach (var order in Model)
        {
            var statusClass = order.Status?.ToLower() switch
            {
                "pending" => "status-pending",
                "processing" => "status-processing",
                "shipped" => "status-shipped",
                "delivered" => "status-delivered",
                "cancelled" => "status-cancelled",
                _ => "status-pending"
            };

            <div class="order-card">
                <div class="order-info">
                    <div class="order-id">#@order.Id</div>
                    <div class="order-meta">
                        <strong>@(order.FullName ?? order.User?.Name ?? "N/A")</strong><br />
                        @order.dateTime.ToString("MMM dd, yyyy HH:mm")
                    </div>
                    <div class="order-meta">
                        Items: <strong>@order.OrderItems.Count</strong><br />
                        Total: <strong>@order.TotalPrice.ToString("N0") EGP</strong>
                    </div>
                    @if (!string.IsNullOrEmpty(order.City))
                    {
                        <div class="order-meta">@order.City</div>
                    }
                </div>
                <div style="display:flex;gap:10px;align-items:center;">
                    <span class="status-badge @statusClass">@order.Status</span>
                    <a href="/Manage/OrderDetails/@order.Id" class="btn-view">View</a>
                </div>
            </div>
        }
    </div>
</body>
</html>
