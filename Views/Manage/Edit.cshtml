@model ProductVM
@{
    Layout=null;
}

<head>
    <link href="~/css/Edit.css" rel="stylesheet" />
</head>
<body>
<div class="page" >
    <div class="header">
        <h1>Edit</h1>
        <p>Fill in the details below to add a product to your store</p>
    </div>

    <form asp-action="Edit" asp-controller="Manage" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div class="layout">

            <!-- Left column -->
            <div>

                <!-- Basic info -->
                <div class="card">
                    <div class="section-title">Basic information</div>

                    <div class="field">
                        <label asp-for="Name">Product name</label>
                        <input asp-for="Name" placeholder="e.g. Wireless Headphones" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Description">Description</label>
                        <textarea asp-for="Description" placeholder="Describe the product — features, materials, specs..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

                <!-- Pricing & inventory -->
                <div class="card">
                    <div class="section-title">Pricing & inventory</div>

                    <div class="row2">
                        <div class="field">
                            <label asp-for="Price">Price </label>
                            <div class="price-wrap">
                                <span class="currency">EGP</span>
                                <input asp-for="Price" type="number" placeholder="0.00" min="0" step="0.01" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="field">
                            <label asp-for="Quantity">Quantity in stock </label>
                            <input asp-for="Quantity" type="number" placeholder="0" min="0" step="1" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="field">
                        <label asp-for="CategoryId">Category</label>
                        <select asp-for="CategoryId" asp-items="@(ViewBag.Categories as SelectList)" class="form-control">
                            <option value="">-- No Category --</option>
                        </select>
                    </div>
                </div>

            </div>

            <!-- Right column -->
            <div>
                <div class="card">
                    <div class="section-title">Product image</div>

                    <div class="img-preview" id="img-box">
                        <img src="@Model.ImageUrl" width="150" alt="Product image" />
                        
                    </div>

                    <div class="field" style="margin-bottom:0">
                        <label asp-for="ImageUrl">Image URL</label>
                        <input asp-for="ImageUrl" placeholder="https://..." oninput="updateImg(this.value)" />
                        <div class="hint">Paste a direct link to the product image</div>
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    </div>
                </div>
            </div>

        </div>

        <!-- Action buttons -->
        <div class="actions">
            <a href="@Url.Action("Index")" class="btn" style="text-align:center;text-decoration:none;color:inherit">Cancel</a>
            <button type="submit" class="btn btn-save">Save product</button>
        </div>

    </form>
    </div>
    
</body>