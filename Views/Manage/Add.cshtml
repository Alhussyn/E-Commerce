@* @model IEnumerable<E_Commerce.Models.Product> *@
@model ProductVM

@{
    ViewData["Title"] = "Add New Product";
}

<style>
    .page { max-width: 860px; margin: 2rem auto; padding: 0 1rem; font-family: sans-serif; }

    .header { display: flex; align-items: center; gap: 12px; margin-bottom: 2rem; }
    .header h1 { font-size: 20px; font-weight: 500; margin: 0; }
    .header p  { font-size: 13px; color: #888; margin: 2px 0 0; }

    .layout { display: grid; grid-template-columns: 1fr 280px; gap: 20px; align-items: start; }

    .card {
        background: #fff;
        border: 0.5px solid #e0e0e0;
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 16px;
    }

    .section-title {
        font-size: 12px;
        font-weight: 500;
        color: #999;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 1rem;
        padding-bottom: 8px;
        border-bottom: 0.5px solid #eee;
    }

    .field { margin-bottom: 1rem; }
    .field label { display: block; font-size: 13px; font-weight: 500; margin-bottom: 5px; }
    .field input, .field textarea {
        width: 100%;
        padding: 8px 12px;
        border: 0.5px solid #d0d0d0;
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
    }
    .field input:focus, .field textarea:focus { border-color: #555; }
    .field textarea { height: 90px; resize: vertical; }
    .field .hint { font-size: 11px; color: #aaa; margin-top: 3px; }

    .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

    .price-wrap { position: relative; }
    .price-wrap input { padding-left: 52px; }
    .currency { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); font-size: 13px; color: #999; }

    .img-preview {
        width: 100%;
        height: 160px;
        border: 0.5px dashed #ccc;
        border-radius: 8px;
        background: #f9f9f9;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
    }
    .img-preview img { width: 100%; height: 100%; object-fit: cover; display: none; }
    .img-placeholder { text-align: center; color: #bbb; font-size: 12px; }

    .actions { display: flex; gap: 10px; margin-top: 1.5rem; }
    .btn {
        flex: 1;
        padding: 10px;
        border: 0.5px solid #d0d0d0;
        border-radius: 8px;
        background: #fff;
        font-size: 14px;
        cursor: pointer;
    }
    .btn-save { background: #111; color: #fff; border-color: transparent; font-weight: 500; }
    .btn-save:hover { background: #333; }

    .text-danger { color: #e24b4a; font-size: 11px; }
    .required { color: #e24b4a; }

    @@media (max-width: 640px) {
        .layout { grid-template-columns: 1fr; }
        .row2 { grid-template-columns: 1fr; }
    }
</style>

<div class="page">

    <div class="header">
        <div>
            <h1>Add new product</h1>
            <p>Fill in the details below to add a product to your store</p>
        </div>
    </div>

    <form asp-action="Add" method="post">
        @Html.AntiForgeryToken()

        <div class="layout">

            <!-- Left column -->
            <div>

                <!-- Basic info -->
                <div class="card">
                    <div class="section-title">Basic information</div>

                    <div class="field">
                        <label asp-for="Name">Product name <span class="required">*</span></label>
                        <input asp-for="Name" placeholder="e.g. Wireless Headphones" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Description">Description</label>
                        <textarea asp-for="Description" placeholder="Describe the product — features, materials, specs..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

                <!-- Pricing & inventory -->
                <div class="card">
                    <div class="section-title">Pricing & inventory</div>

                    <div class="row2">
                        <div class="field">
                            <label asp-for="Price">Price <span class="required">*</span></label>
                            <div class="price-wrap">
                                <span class="currency">EGP</span>
                                <input asp-for="Price" type="number" placeholder="0.00" min="0" step="0.01" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="field">
                            <label asp-for="Quantity">Quantity in stock <span class="required">*</span></label>
                            <input asp-for="Quantity" type="number" placeholder="0" min="0" step="1" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="field">
                        <label asp-for="CategoryId">Category</label>
                        <select asp-for="CategoryId" asp-items="@(ViewBag.Categories as SelectList)" class="form-control">
                            <option value="">-- No Category --</option>
                        </select>
                    </div>
                </div>

            </div>

            <!-- Right column -->
            <div>
                <div class="card">
                    <div class="section-title">Product image</div>

                    <div class="img-preview" id="img-box">
                        <img id="img-tag" src="" alt="preview" />
                        <div class="img-placeholder" id="img-placeholder">
                            <p>Image preview<br />will appear here</p>
                        </div>
                    </div>

                    <div class="field" style="margin-bottom:0">
                        <label asp-for="ImageUrl">Image URL <span class="required">*</span></label>
                        <input asp-for="ImageUrl" placeholder="https://..." oninput="updateImg(this.value)" />
                        <div class="hint">Paste a direct link to the product image</div>
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    </div>
                </div>
            </div>

        </div>

        <!-- Action buttons -->
        <div class="actions">
            <a href="@Url.Action("Index")" class="btn" style="text-align:center;text-decoration:none;color:inherit">Cancel</a>
            <button type="submit" class="btn btn-save">Save product</button>
        </div>

    </form>
</div>

<script>
    function updateImg(url) {
        var img = document.getElementById('img-tag');
        var ph  = document.getElementById('img-placeholder');
        if (url) {
            img.src = url;
            img.style.display = 'block';
            ph.style.display  = 'none';
            img.onerror = function () {
                img.style.display = 'none';
                ph.style.display  = 'block';
            };
        } else {
            img.style.display = 'none';
            ph.style.display  = 'block';
        }
    }
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


