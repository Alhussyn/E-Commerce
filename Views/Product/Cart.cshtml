@model Cart

<!DOCTYPE html>
<html>
<head>
    <title>Cart</title>

    <style>
        body {
            font-family: Arial;
            background: #f5f5f5;
            padding: 20px;
        }

        .container {
            width: 85%;
            margin: auto;
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px #ccc;
        }

        h2 {
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #333;
            color: white;
            padding: 10px;
        }

        td {
            padding: 10px;
            text-align: center;
            border-bottom: 1px solid #ddd;
        }

        img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 5px;
        }

        .total {
            text-align: right;
            font-size: 18px;
            margin-top: 15px;
        }

        .btn {
            padding: 10px 15px;
            border: none;
            cursor: pointer;
            border-radius: 5px;
        }

        .buy-btn {
            background: green;
            color: white;
        }

        .back-btn {
            margin:10px;
            background:gray;
            color: white;
            text-decoration: none;
            padding: 10px;
            border-radius:5px;
        }
        .clear-btn{
            margin:10px;
            padding: 10px 15px;
            border: none;
            cursor: pointer;
            border-radius: 5px;
            background-color:darkkhaki;
            color:aliceblue
        }
    </style>
</head>

<body>
    <br />
    <h2>🛒 Your Cart</h2>
    <br />
    <div class="container">
        <br />
        
        

        @if (Model == null || Model.CartItems.Count == 0)
        {
            <p style="text-align:center;color:red;">Cart is empty</p>
        }
        else
        {
            decimal total = 0;

            <table>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                </tr>

                @foreach (var item in Model.CartItems)
                {
                    var itemTotal = item.Quantity * item.Product.Price;
                    total += itemTotal;

                    <tr>
                        <td>
                            <img src="@item.Product.ImageUrl" />
                        </td>

                        <td>@item.Product.Name</td>

                        <td>@item.Product.Description</td>

                        <td>@item.Product.Price</td>

                        <td>@item.Quantity</td>

                        <td>@itemTotal</td>
                    </tr>
                }
            </table>

            <div class="total">
                <strong>Total Price: @total</strong>
            </div>

            <br />

            <button class="btn buy-btn">Buy Now</button>
            <br />
            <form asp-controller="Product" asp-action="ClearCart" method="post">
                <button type="submit" class="clear-btn">Clear</button>
            </form>

        }

        <br /><br />

        <a href="/Product/Index" class="back-btn">⬅ Back</a>

    </div>

</body>
</html>