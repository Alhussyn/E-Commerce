@model E_Commerce.ViewModels.CheckoutViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Checkout</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/checkout.css" />
    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: 
                radial-gradient(ellipse at top right, rgba(92, 124, 250, 0.1), transparent 50%),
                linear-gradient(135deg, #f8faff 0%, #eef2ff 50%, #f5f8ff 100%);
            min-height: 100vh;
            padding: 40px;
            color: #111827;
            -webkit-font-smoothing: antialiased;
        }

        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .checkout-container {
            max-width: 1100px;
            margin: auto;
            display: grid;
            grid-template-columns: 1.2fr .8fr;
            gap: 28px;
            animation: fadeInUp 500ms ease-out;
        }

        .card {
            background: #ffffff;
            border-radius: 24px;
            padding: 36px;
            border: 1.5px solid #e2e8f0;
            box-shadow: 0 4px 24px rgba(17, 24, 39, 0.06);
        }

        .title {
            font-size: 1.6rem;
            font-weight: 900;
            margin-bottom: 28px;
            letter-spacing: -0.02em;
            color: #111827;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #475569;
            font-size: 0.88rem;
            font-weight: 600;
        }

        .form-control {
            width: 100%;
            height: 52px;
            border: 1.5px solid #e2e8f0;
            outline: none;
            border-radius: 12px;
            background: #f8faff;
            color: #111827;
            padding: 0 16px;
            font-size: 0.95rem;
            transition: all 200ms ease;
        }

        .form-control:focus {
            border-color: rgba(59, 91, 219, 0.6);
            box-shadow: 0 0 0 4px rgba(92, 124, 250, 0.12);
            background: #ffffff;
        }

        textarea.form-control {
            height: 110px;
            padding-top: 14px;
            resize: none;
        }

        .summary-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .summary-item:last-of-type {
            border-bottom: none;
        }

        .summary-item img {
            width: 64px;
            height: 64px;
            border-radius: 12px;
            object-fit: cover;
            border: 1.5px solid #e2e8f0;
        }

        .product-info {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .product-name {
            font-weight: 700;
            margin-bottom: 4px;
            font-size: 0.95rem;
            color: #111827;
        }

        .product-price {
            color: #64748b;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .total {
            margin-top: 28px;
            display: flex;
            justify-content: space-between;
            font-size: 1.6rem;
            font-weight: 900;
            letter-spacing: -0.02em;
            padding-top: 20px;
            border-top: 2px solid #e2e8f0;
        }

        .checkout-btn {
            width: 100%;
            height: 56px;
            border: none;
            border-radius: 14px;
            background: linear-gradient(135deg, #3b5bdb, #5c7cfa);
            color: white;
            font-size: 1.05rem;
            font-weight: 700;
            cursor: pointer;
            margin-top: 28px;
            transition: all 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 8px 20px rgba(59, 91, 219, 0.25);
        }

        .checkout-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(59, 91, 219, 0.35);
        }

        .checkout-btn:active {
            transform: translateY(0) scale(0.98);
        }

        .checkout-btn.is-loading {
            position: relative;
            color: transparent;
            pointer-events: none;
        }

        .checkout-btn.is-loading::after {
            content: '';
            position: absolute;
            width: 22px;
            height: 22px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-right-color: #ffffff;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
            left: calc(50% - 11px);
            top: calc(50% - 11px);
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        .field-error {
            display: block;
            margin-top: 6px;
            color: #e63946;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .validation-summary {
            background: #fef2f2;
            border: 1.5px solid #fca5a5;
            border-radius: 12px;
            padding: 14px 18px;
            margin-bottom: 20px;
            color: #991b1b;
            font-size: 0.9rem;
        }

        @@media (max-width: 992px) {
            .checkout-container {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 480px) {
            body {
                padding: 20px 16px;
            }

            .card {
                padding: 24px 20px;
            }

            .title {
                font-size: 1.3rem;
            }
        }
    </style>

</head>

<body>

    <form asp-action="Checkout"
          method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="checkout-container">

            <!-- LEFT -->

            <div class="card">

                <h1 class="title">
                    Checkout Information
                </h1>

                <div class="form-group">

                    <label>
                        Full Name
                    </label>

                    <input asp-for="FullName"
                           class="form-control" autocomplete="name">
                    <span asp-validation-for="FullName" class="field-error"></span>

                </div>

                <div class="form-group">

                    <label>
                        Phone Number
                    </label>

                    <input asp-for="Phone"
                           class="form-control" autocomplete="tel">
                    <span asp-validation-for="Phone" class="field-error"></span>

                </div>

                <div class="form-group">

                    <label>
                        Address
                    </label>

                    <input asp-for="Address"
                           class="form-control" autocomplete="street-address">
                    <span asp-validation-for="Address" class="field-error"></span>

                </div>

                <div class="form-group">

                    <label>
                        City
                    </label>

                    <input asp-for="City"
                           class="form-control" autocomplete="address-level2">
                    <span asp-validation-for="City" class="field-error"></span>

                </div>

                <div class="form-group">

                    <label>
                        Delivery Date
                    </label>

                    <input asp-for="DeliveryDate"
                           type="date"
                           class="form-control">

                </div>

                <div class="form-group">

                    <label>
                        Notes
                    </label>

                    <textarea asp-for="Notes"
                              class="form-control"></textarea>

                </div>

            </div>

            <!-- RIGHT -->

            <div class="card">

                <h1 class="title">
                    Order Summary
                </h1>

                @foreach (var item in Model.CartItems)
                {
                        <div class="summary-item">

                            <div class="product-info">

                                @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                                {
                                    <img src="@item.ProductImageUrl" alt="@item.ProductName">
                                }

                                <div>

                                    <div class="product-name">
                                        @item.ProductName
                                    </div>

                                    <div class="product-price">
                                        Quantity:
                                        @item.Quantity
                                    </div>

                                </div>

                            </div>

                            <strong>
                                @item.ItemTotal EGP
                            </strong>

                        </div>
                }

                <div class="total">

                    <span>
                        Total
                    </span>

                    <span>
                        @Model.TotalPrice EGP
                    </span>

                </div>

                <button type="submit"
                        class="checkout-btn"
                        id="checkout-btn">

                    Place Order

                </button>

                <script>
                    document.getElementById('checkout-btn').addEventListener('click', function() {
                        setTimeout(() => this.classList.add('is-loading'), 50);
                    });
                </script>

            </div>

        </div>

    </form>

</body>

</html>
