@model IEnumerable<E_Commerce.Models.Product>

@{
    ViewData["Title"] = "Products";
    Layout = null;

    var search = Context.Request.Query["searchTerm"].ToString();
    var sort = Context.Request.Query["sortOrder"].ToString();
    var searchTerm = ViewBag.SearchTerm as string ?? search;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var sortOrder = ViewBag.SortOrder as string ?? sort;
}

@if (TempData["CartMessage"] != null)
{
    <div id="toast" class="toast">
        @TempData["CartMessage"]
    </div>
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Products</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
          rel="stylesheet" />

    <link href="~/css/index.css"
          rel="stylesheet" />

</head>

<body>

    <main class="page-shell">

        <!-- HEADER -->

        <header class="site-header">

            <!-- LOGO -->

            <a class="brand"
               asp-controller="Product"
               asp-action="Index">

                <span class="brand-mark">
                    E
                </span>

                <span class="brand-copy">

                    <strong>
                        E-Commerce
                    </strong>

                    @if (Context.Session.GetString("UserName") != null)
                    {
                        <span>
                            Welcome
                            @Context.Session.GetString("UserName")
                        </span>
                    }
                    else
                    {
                        <span>
                            Curated premium goods
                        </span>
                    }

                </span>

            </a>

            <!-- NAVIGATION -->

            <nav class="nav-links">

                <a class="active"
                   asp-controller="Product"
                   asp-action="Index">

                    Featured

                </a>

                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-sortOrder="name">

                    New

                </a>

                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-sortOrder="stock">

                    Design

                </a>

                <!-- 🔥 MANAGER ONLY -->
                @if (Context.Session.GetString("UserRole") == "Manager")
                {
                    <a asp-controller="Manage"
                       asp-action="Index">

                        Dashboard

                    </a>
                }

            </nav>

            <!-- RIGHT BUTTONS -->
            @if (Context.Session.GetInt32("UserId") != null)
            {
                <div style="display:flex; gap:10px; align-items:center;">

                    <!-- CART -->

                    <a class="cart-button"
                       asp-controller="Product"
                       asp-action="Cart">

                        <span>Cart <strong data-cart-count>@(ViewBag.CartCount ?? 0)</strong></span>

                        @* <strong>
                            @Model.Sum(p => p.Quantity)
                        </strong> *@

                    </a>

                    <!-- ORDERS -->

                    <a class="cart-button"
                       asp-controller="Order"
                       asp-action="Index">

                        Orders

                    </a>

                    <!-- PROFILE -->

                    <a class="cart-button"
                       asp-controller="Profile"
                       asp-action="Index"
                       style="background:#f1f5f9;color:#1e293b;">

                        Profile

                    </a>

                    <!-- LOGOUT -->

                    <a class="cart-button"
                       asp-controller="Auth"
                       asp-action="Logout">

                        Logout

                    </a>

                </div>
            }
            else
            {
                <a class="cart-button"
                   asp-controller="Auth"
                   asp-action="SignIn">

                    Login

                </a>
            }

        </header>

        <!-- HERO -->

        <section class="hero">

            <div class="hero-copy">

                <p class="eyebrow">
                    Premium essentials
                </p>

                <h1>
                    Discover quality products for everyday life.
                </h1>

                <p>
                    Browse our curated collection of electronics, home goods,
                    accessories, and smart devices — all with fast delivery
                    and secure checkout.
                </p>

            </div>

            <!-- SEARCH PANEL -->

            <aside class="search-panel">

                <form method="get"
                      class="search-form">

                    <label class="search-wrap">

                        <svg width="20"
                             height="20"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">

                            <circle cx="11"
                                    cy="11"
                                    r="8" />

                            <line x1="21"
                                  y1="21"
                                  x2="16.65"
                                  y2="16.65" />

                        </svg>

                        <input type="search"
                               name="searchTerm"
                               placeholder="Search products, brands, categories"
                               value="@search" />

                    </label>

                    <select class="filter-select"
                            name="sortOrder"
                            onchange="this.form.submit()">

                        <option value="">
                            Default sorting
                        </option>

                        <option value="price-asc"
                                selected="@(sort == "price-asc")">

                            Price: Low to High

                        </option>

                        <option value="price-desc"
                                selected="@(sort == "price-desc")">

                            Price: High to Low

                        </option>

                        <option value="name"
                                selected="@(sort == "name")">

                            Name A-Z

                        </option>

                        <option value="stock"
                                selected="@(sort == "stock")">

                            Most Stock

                        </option>

                    </select>

                </form>

                <!-- STATS -->

                <div class="stats">

                    <div class="stat">

                        <strong>
                            @Model.Count()
                        </strong>

                        <span>
                            Products
                        </span>

                    </div>

                    <div class="stat">

                        <strong>
                            @Model.Sum(p => p.Quantity)
                        </strong>

                        <span>
                            In stock
                        </span>

                    </div>

                    <div class="stat">

                        <strong>
                            @(ViewBag.Categories != null ? ((List<E_Commerce.Models.Category>)ViewBag.Categories).Count : 0)
                        </strong>

                        <span>
                            Categories
                        </span>

                    </div>

                </div>

            </aside>

        </section>

        <!-- COLLECTION / PRODUCTS GRID -->

        <section class="collection">

            <div class="section-head">

                <div>
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <h2>Search results for "@searchTerm"</h2>
                        <p>@Model.Count() product@(Model.Count() != 1 ? "s" : "") found.</p>
                    }
                    else if (ViewBag.SelectedCategoryName != null)
                    {
                        <h2>@ViewBag.SelectedCategoryName</h2>
                        <p>Browse all products in this category.</p>
                    }
                    else
                    {
                        <h2>Our Products</h2>
                        <p>Explore our full collection of quality products.</p>
                    }
                </div>

                <div class="quick-filters">

                    <a class="filter-pill @(ViewBag.SelectedCategory == null ? "active" : "")"
                       asp-controller="Product"
                       asp-action="Index">
                        All
                    </a>

                    @if (ViewBag.Categories != null)
                    {
                        @foreach (var cat in (List<E_Commerce.Models.Category>)ViewBag.Categories)
                        {
                            <a class="filter-pill @(ViewBag.SelectedCategory == cat.Id ? "active" : "")"
                               asp-controller="Product"
                               asp-action="Index"
                               asp-route-categoryId="@cat.Id">
                                @cat.Name
                            </a>
                        }
                    }

                </div>

            </div>

            <div class="grid">

                @if (!Model.Any())
                {
                    <div class="empty">
                        <p>No products found.</p>
                    </div>
                }

                @foreach (var product in Model)
                {
                    <article class="card">

                            <a class="card-image" href="/Product/Details/@product.Id" aria-label="View @product.Name details">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.Name" loading="lazy">
                            }
                            else
                            {
                                <span>No Image</span>
                            }
                            </a>

                        <div class="card-body">

                            <div class="card-topline">

                                <span class="category">@(product.Category?.Name ?? "Product")</span>

                                @if (product.DiscountPercent > 0)
                                {
                                    <span class="discount-badge">-@product.DiscountPercent.ToString("0")%</span>
                                }
                                else if (product.Quantity > 5)
                                {
                                    <span class="badge badge-in">In Stock</span>
                                }
                                else if (product.Quantity > 0)
                                {
                                    <span class="badge badge-low">Low Stock</span>
                                }
                                else
                                {
                                    <span class="badge badge-out">Out of Stock</span>
                                }

                            </div>

                            <h3 class="card-name">@product.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(product.Brand))
                            {
                                <span class="card-brand">@product.Brand</span>
                            }
                            <p class="card-desc">@product.Description</p>

                            <div class="card-meta">
                                <div>
                                    @if (product.DiscountPercent > 0)
                                    {
                                        <span class="price">@product.FinalPrice.ToString("N0") EGP</span>
                                        <span class="old-price">@product.Price.ToString("N0")</span>
                                        <span class="discount-badge">-@product.DiscountPercent.ToString("0")%</span>
                                    }
                                    else
                                    {
                                        <span class="price">@product.Price.ToString("N0") EGP</span>
                                    }
                                </div>
                                <span class="rating">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                    Premium
                                </span>
                            </div>

                            <div class="card-footer">
                                <a href="/Product/Details/@product.Id" class="btn btn-ghost">Details</a>
                                <form asp-controller="Product" asp-action="Buy" asp-route-id="@product.Id" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-primary">Buy Now</button>
                                </form>
                                <form asp-controller="Product" asp-action="AddToCart" asp-route-id="@product.Id" method="post" class="js-add-cart" style="display:inline;">
                                    <button type="submit" class="btn btn-secondary">Add To Cart</button>
                                </form>
                            </div>

                        </div>

                    </article>
                }

            </div>

            <!-- PAGINATION -->
            @if (totalPages > 1)
            {
                <nav class="pagination" aria-label="Product pages">
                    @if (currentPage > 1)
                    {
                        <a href="?page=@(currentPage-1)&searchTerm=@searchTerm&sortOrder=@sortOrder" aria-label="Previous page">&larr; Prev</a>
                    }

                    @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                    {
                        <a href="?page=@i&searchTerm=@searchTerm&sortOrder=@sortOrder" class="@(i == currentPage ? "active" : "")" aria-label="Page @i" aria-current="@(i == currentPage ? "page" : null)">@i</a>
                    }

                    @if (currentPage < totalPages)
                    {
                        <a href="?page=@(currentPage+1)&searchTerm=@searchTerm&sortOrder=@sortOrder" aria-label="Next page">Next &rarr;</a>
                    }
                </nav>
            }

        </section>

        </main>
    <script src="~/js/storefront.js" defer></script>
    <script src="~/js/image-fallback.js" defer></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {

            // Search auto-submit with debounce
            const searchInput = document.querySelector('input[name="searchTerm"]');

            if (searchInput) {
                const form = searchInput.closest("form");
                let timeout;

                searchInput.addEventListener("input", () => {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => {
                        form.submit();
                    }, 600);
                });
            }

            // Toast notification
            const toast = document.getElementById("toast");

            if (toast) {
                requestAnimationFrame(() => toast.classList.add("show"));

                setTimeout(() => {
                    toast.classList.remove("show");
                }, 3200);
            }

        });
    </script>

</body>

</html>
